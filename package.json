{
  "name": "@bryanadamg/terras-ui",
  "version": "0.20.0",
  "description": "Shared design tokens + UI components for Terras apps — ERP, CRM, SKU",
  "license": "UNLICENSED",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src"
  ],
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./css": "./src/tokens/tokens.css",
    "./chrome": "./src/components/chrome.css",
    "./scale.css": "./src/tokens/scale.css",
    "./scale": { "types": "./src/scale.d.ts", "default": "./src/scale.js" },
    "./tokens.json": "./src/tokens/tokens.json",
    "./assets/*": "./src/assets/*",
    "./types": { "types": "./src/components/types.d.ts" },
    "./styles": { "types": "./src/components/styles.d.ts", "default": "./src/components/styles.js" },
    "./components/AccessDenied": { "types": "./src/components/AccessDenied.d.ts", "default": "./src/components/AccessDenied.js" },
    "./components/AppHeader": { "types": "./src/components/AppHeader.d.ts", "default": "./src/components/AppHeader.js" },
    "./components/AppLoadBar": { "types": "./src/components/AppLoadBar.d.ts", "default": "./src/components/AppLoadBar.js" },
    "./components/BootSplash": { "types": "./src/components/BootSplash.d.ts", "default": "./src/components/BootSplash.js" },
    "./components/Button": { "types": "./src/components/Button.d.ts", "default": "./src/components/Button.js" },
    "./components/Chip": { "types": "./src/components/Chip.d.ts", "default": "./src/components/Chip.js" },
    "./components/CityMatrix": { "types": "./src/components/CityMatrix.d.ts", "default": "./src/components/CityMatrix.js" },
    "./components/Combobox": { "types": "./src/components/Combobox.d.ts", "default": "./src/components/Combobox.js" },
    "./components/ConfirmModal": { "types": "./src/components/ConfirmModal.d.ts", "default": "./src/components/ConfirmModal.js" },
    "./components/EmptyState": { "types": "./src/components/EmptyState.d.ts", "default": "./src/components/EmptyState.js" },
    "./components/Field": { "types": "./src/components/Field.d.ts", "default": "./src/components/Field.js" },
    "./components/FilterChipBar": { "types": "./src/components/FilterChipBar.d.ts", "default": "./src/components/FilterChipBar.js" },
    "./components/FormSection": { "types": "./src/components/FormSection.d.ts", "default": "./src/components/FormSection.js" },
    "./components/LoginScreen": { "types": "./src/components/LoginScreen.d.ts", "default": "./src/components/LoginScreen.js" },
    "./components/LogoutButton": { "types": "./src/components/LogoutButton.d.ts", "default": "./src/components/LogoutButton.js" },
    "./components/Modal": { "types": "./src/components/Modal.d.ts", "default": "./src/components/Modal.js" },
    "./components/Pager": { "types": "./src/components/Pager.d.ts", "default": "./src/components/Pager.js" },
    "./components/ProgressBar": { "types": "./src/components/ProgressBar.d.ts", "default": "./src/components/ProgressBar.js" },
    "./components/SegmentedBar": { "types": "./src/components/SegmentedBar.d.ts", "default": "./src/components/SegmentedBar.js" },
    "./components/Sidebar": { "types": "./src/components/Sidebar.d.ts", "default": "./src/components/Sidebar.js" },
    "./components/Skeleton": { "types": "./src/components/Skeleton.d.ts", "default": "./src/components/Skeleton.js" },
    "./components/Table": { "types": "./src/components/Table.d.ts", "default": "./src/components/Table.js" },
    "./components/Toast": { "types": "./src/components/Toast.d.ts", "default": "./src/components/Toast.js" },
    "./components/Tabs": { "types": "./src/components/Tabs.d.ts", "default": "./src/components/Tabs.js" },
    "./components/ToggleChip": { "types": "./src/components/ToggleChip.d.ts", "default": "./src/components/ToggleChip.js" },
    "./components/Window": { "types": "./src/components/Window.d.ts", "default": "./src/components/Window.js" },
    "./components/WindowCloseButton": { "types": "./src/components/WindowCloseButton.d.ts", "default": "./src/components/WindowCloseButton.js" }
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bryanadamg/terras-ui.git"
  }
}
