{
  "name": "@bryanadamg/terras-ui",
  "version": "0.11.2",
  "description": "Shared design tokens + UI components for Terras apps — ERP, CRM, SKU",
  "license": "UNLICENSED",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src"
  ],
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./css": "./src/tokens/tokens.css",
    "./chrome": "./src/components/chrome.css",
    "./tokens.json": "./src/tokens/tokens.json",
    "./assets/*": "./src/assets/*",
    "./styles": { "types": "./src/components/styles.d.ts", "default": "./src/components/styles.js" },
    "./components/AppHeader": { "types": "./src/components/AppHeader.d.ts", "default": "./src/components/AppHeader.js" },
    "./components/Button": { "types": "./src/components/Button.d.ts", "default": "./src/components/Button.js" },
    "./components/Chip": { "types": "./src/components/Chip.d.ts", "default": "./src/components/Chip.js" },
    "./components/Combobox": { "types": "./src/components/Combobox.d.ts", "default": "./src/components/Combobox.js" },
    "./components/Field": { "types": "./src/components/Field.d.ts", "default": "./src/components/Field.js" },
    "./components/FilterChipBar": { "types": "./src/components/FilterChipBar.d.ts", "default": "./src/components/FilterChipBar.js" },
    "./components/FormSection": { "types": "./src/components/FormSection.d.ts", "default": "./src/components/FormSection.js" },
    "./components/Modal": { "types": "./src/components/Modal.d.ts", "default": "./src/components/Modal.js" },
    "./components/SegmentedBar": { "types": "./src/components/SegmentedBar.d.ts", "default": "./src/components/SegmentedBar.js" },
    "./components/Sidebar": { "types": "./src/components/Sidebar.d.ts", "default": "./src/components/Sidebar.js" },
    "./components/Table": { "types": "./src/components/Table.d.ts", "default": "./src/components/Table.js" },
    "./components/Tabs": { "types": "./src/components/Tabs.d.ts", "default": "./src/components/Tabs.js" },
    "./components/ToggleChip": { "types": "./src/components/ToggleChip.d.ts", "default": "./src/components/ToggleChip.js" },
    "./components/Window": { "types": "./src/components/Window.d.ts", "default": "./src/components/Window.js" }
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bryanadamg/terras-ui.git"
  }
}
